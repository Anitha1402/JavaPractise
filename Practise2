import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;

public class TopLongestStrings {
    public static void main(String[] args) {
        List<String> strings = Arrays.asList(
            "Apple", "Banana", "Avocado", "Mango", "Pineapple",
            "Grapes", "Orange", "Strawberry", "Kiwi", "Papaya"
        );

        List<String> stringsWithA = new ArrayList<>();
        for (String str : strings) {
            if (str.toLowerCase().contains("a")) {
                stringsWithA.add(str);
            }
        }

        for (int i = 0; i < stringsWithA.size() - 1; i++) {
            for (int j = 0; j < stringsWithA.size() - i - 1; j++) {
                if (stringsWithA.get(j).length() < stringsWithA.get(j + 1).length()) {
                    // Swap
                    String temp = stringsWithA.get(j);
                    stringsWithA.set(j, stringsWithA.get(j + 1));
                    stringsWithA.set(j + 1, temp);
                }
            }
        }

        int limit = Math.min(5, stringsWithA.size());

        System.out.println("Top 5 longest strings containing 'a' or 'A':");
        for (int i = 0; i < limit; i++) {
            System.out.println(stringsWithA.get(i));
        }
    }
}
